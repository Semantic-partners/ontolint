# Catalogue of the vocabularies bundled with ontolint, as a DCAT catalog.
#
# This catalog is the starting point for discovery: ontolint reads it to find which
# vocabularies are bundled, their namespaces and where each file is.
#
# Each dcat:Dataset is one vocabulary: its namespace (vann:preferredNamespaceUri) and
# prefix, the exact URL it was retrieved from (dcterms:source), its licence and version,
# how the bundled file relates to that source (skos:changeNote), and a dcat:Distribution
# whose dcat:downloadURL is the bundled file (relative to this catalog) with its SHA-256
# checksum. ontolint adds every namespace to imports.local, so these namespaces and
# owl:imports of these ontologies resolve offline. Entries are matched with or without a
# trailing '#' or '/', and a project's own imports.local entry wins.

@prefix ontolint: <https://ontolint.org/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix spdx:    <http://spdx.org/rdf/terms#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

ontolint:vocabularies a dcat:Catalog ;
    rdfs:label "Vocabularies bundled with ontolint" ;
    dcterms:title "Vocabularies bundled with ontolint" ;
    dcterms:description "Standard RDF vocabularies shipped with ontolint so their terms can be validated offline." ;
    dcterms:modified "2026-10-05"^^xsd:date ;
    dcat:dataset
        ontolint:vocabulary-rdf,
        ontolint:vocabulary-rdfs,
        ontolint:vocabulary-owl,
        ontolint:vocabulary-xsd,
        ontolint:vocabulary-shacl,
        ontolint:vocabulary-skos,
        ontolint:vocabulary-dcterms,
        ontolint:vocabulary-dc,
        ontolint:vocabulary-dcam,
        ontolint:vocabulary-dctype,
        ontolint:vocabulary-foaf,
        ontolint:vocabulary-vann,
        ontolint:vocabulary-vs,
        ontolint:vocabulary-prov,
        ontolint:vocabulary-org,
        ontolint:vocabulary-dcat3,
        ontolint:vocabulary-vcard,
        ontolint:vocabulary-schema-http,
        ontolint:vocabulary-schema-https,
        ontolint:vocabulary-dqv,
        ontolint:vocabulary-time,
        ontolint:vocabulary-odrl,
        ontolint:vocabulary-dash .

ontolint:vocabulary-rdf a dcat:Dataset ;
    rdfs:label "RDF" ;
    dcterms:title "RDF" ;
    vann:preferredNamespaceUri "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ;
    vann:preferredNamespacePrefix "rdf" ;
    dcterms:source <http://www.w3.org/1999/02/22-rdf-syntax-ns> ;
    dcterms:license <https://www.w3.org/copyright/software-license/> ;
    dcat:version "RDF 1.1 namespace document (2019-12-16), plus RDF 1.2 additions" ;
    skos:changeNote "The source (retrieved 2026-10-01) verbatim, followed by an 'Added for ontolint' block with the RDF 1.2 terms it does not yet contain: rdf:dirLangString and rdf:reifies (RDF 1.2 Concepts), rdf:PropositionForm and rdf:propositionFormSubject/Predicate/Object (RDF 1.2 Interoperability), and the rdf:version-* IRIs." ;
    dcat:distribution ontolint:vocabulary-rdf-turtle .

ontolint:vocabulary-rdf-turtle a dcat:Distribution ;
    rdfs:label "RDF (Turtle)" ;
    dcat:downloadURL <rdf.ttl> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ;
    spdx:checksum ontolint:vocabulary-rdf-turtle-sha256 .

ontolint:vocabulary-rdf-turtle-sha256 a spdx:Checksum ;
    rdfs:label "RDF (Turtle) SHA-256 checksum" ;
    spdx:algorithm spdx:checksumAlgorithm_sha256 ;
    spdx:checksumValue "95815fa75e730305b3b188aaba4c5aec2e210927327160dec9f31dea10bdc09e" .

