oqa:OntologyDeclaration
    a sh:NodeShape ;
    rdfs:label "Ontology Declaration"@en ;
    rdfs:comment "Ensure that the ontology is declared."@en ;
    sh:targetNode owl:Ontology ;
    sh:property oqa:OntologyRule .

oqa:OntologyRule
    a sh:PropertyShape ;
        sh:path [ sh:inversePath rdf:type ] ;
        sh:minCount 1 ;
        sh:message "FAILURE: No instance of 'owl:Ontology' was found in the graph." ;
        rdfs:label "Ontology Declaration"@en ;
        rdfs:comment "Verify that an ontology has been declared by checking that ^rdf:type has min cardinality 1" .

oqa:OntologyMetadata
    a sh:NodeShape ;
    sh:targetClass owl:Ontology ;
    rdfs:label "Ontology Metadata"@en ;
    rdfs:comment "Ensure that the ontology has a minimal set of metadata declared."@en ;
    sh:message "FAILURE: Ontology Metadata"@en ;
    sh:node oqa:OntologyMetadataChecks .

oqa:OntologyMetadataChecks
    a sh:NodeShape ;
    rdfs:label "Ontology Metadata Checks"@en ;
    rdfs:comment "A shape nested into another one, carrying the messages of individual property shapes reporting individual failures."@en ;
    sh:property oqa:LabelRule, oqa:CommentRule .

