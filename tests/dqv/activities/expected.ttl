<https://example.org/qa#dimension-metadata> a dqv:Dimension ;
    rdfs:label "Metadata" ;
    skos:definition "The ontology declares itself and describes its purpose." ;
    skos:prefLabel "Metadata" .

<https://example.org/qa#metric-properties-same-label> a dqv:Metric ;
    rdfs:label "Properties with the same label" ;
    skos:definition "Two or more properties share a label in the same language." ;
    skos:prefLabel "Properties with the same label" ;
    dqv:inDimension <https://example.org/qa#dimension-uniqueness> ;
    olq:severity sh:Violation .

<https://example.org/qa#metric-undefined-terms> a dqv:Metric ;
    rdfs:label "Undefined terms" ;
    skos:definition "A term is used but defined neither locally nor in its vocabulary (bundled, local or fetched)." ;
    skos:prefLabel "Undefined terms" ;
    dqv:inDimension <https://example.org/qa#dimension-conformance> ;
    olq:severity sh:Violation .

<https://example.org/qa#metric-unresolvable-imports> a dqv:Metric ;
    rdfs:label "Unresolvable imports" ;
    skos:definition "An owl:imports target could not be resolved or contains no triples." ;
    skos:prefLabel "Unresolvable imports" ;
    dqv:inDimension <https://example.org/qa#dimension-conformance> ;
    olq:severity sh:Violation .

<https://example.org/qa#dimension-structure> a dqv:Dimension ;
    rdfs:label "Structure" ;
    skos:definition "Terms are connected into a well-formed hierarchy with domains and ranges." ;
    skos:prefLabel "Structure" .

<https://example.org/ontology/activities#> rdfs:label "Activities" .

<https://example.org/qa#dimension-uniqueness> a dqv:Dimension ;
    rdfs:label "Uniqueness" ;
    skos:definition "Labels and identifiers unambiguously denote a single term." ;
    skos:prefLabel "Uniqueness" .

<https://example.org/qa#dimension-conformance> a dqv:Dimension ;
    rdfs:label "Conformance" ;
    skos:definition "Terms are declared, resolvable and minted in the ontology's own namespace." ;
    skos:prefLabel "Conformance" .

<https://example.org/qa#dimension-documentation> a dqv:Dimension ;
    rdfs:label "Documentation" ;
    skos:definition "Terms carry human-readable labels and descriptions." ;
    skos:prefLabel "Documentation" .

