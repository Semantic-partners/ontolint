# Untyped property
# Property without rdf:Property, owl:ObjectProperty or owl:DatatypeProperty declaration
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX sh: <http://www.w3.org/ns/shacl#>

SELECT DISTINCT ?p
WHERE {
  # Find resources used as predicates
  ?s ?p ?o .

  # exclude blank nodes
  FILTER(isIRI(?s))

  # Restrict to ontology namespace
  OPTIONAL {
    ?ontology a owl:Ontology .
    BIND(REPLACE(STR(?ontology), "^(.{8,})[#/][^#/]*$", "$1") AS ?ns)
  }
  FILTER (!BOUND(?ns) || STRSTARTS(STR(?p), ?ns))
  
  # Use FILTER NOT EXISTS instead of MINUS to avoid join-key type errors
  FILTER NOT EXISTS { ?p a rdf:Property }
  FILTER NOT EXISTS { ?p a owl:ObjectProperty }
  FILTER NOT EXISTS { ?p a owl:DatatypeProperty }
  FILTER NOT EXISTS { ?p a owl:AnnotationProperty }
  FILTER NOT EXISTS { ?p a sh:ConstraintComponent }
  FILTER NOT EXISTS { [] a sh:Parameter ; sh:path ?p }

}
