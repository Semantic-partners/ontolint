<https://example.org/qa#measurement-8c70ab6f605f697e> a dqv:QualityMeasurement ;
    dqv:computedOn <https://example.org/ontology/configuration#> ;
    dqv:isMeasurementOf <https://example.org/qa#metric-classes-missing-description> ;
    dqv:value 1 ;
