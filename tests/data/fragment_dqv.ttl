        <urn:ontolint:violation-urn-ontolint-measurement-undefined-terms-e7b72890> .

<urn:ontolint:metric-classes-missing-description> a dqv:Metric ;
    rdfs:label "Class without description" ;
    skos:definition "A class has no description annotation." ;
    skos:prefLabel "Class without description" ;
    dqv:inDimension <urn:ontolint:dimension-documentation> ;
    olq:severity sh:Warning .

<urn:ontolint:metric-classes-missing-label> a dqv:Metric ;
    rdfs:label "Class without label" ;
    skos:definition "A class has no label annotation." ;
    skos:prefLabel "Class without label" ;
    dqv:inDimension <urn:ontolint:dimension-documentation> ;
    olq:severity sh:Violation .

<urn:ontolint:metric-classes-same-label> a dqv:Metric ;
    rdfs:label "Classes with the same label" ;
    skos:definition "Two or more classes share a label in the same language and with the same predicate." ;
    skos:prefLabel "Classes with the same label" ;
    dqv:inDimension <urn:ontolint:dimension-uniqueness> ;
    olq:severity sh:Violation .

<urn:ontolint:metric-isolated-classes> a dqv:Metric ;
    rdfs:label "Isolated classes" ;
    skos:definition "A class is declared but not connected to the rest of the ontology." ;
    skos:prefLabel "Isolated classes" ;
    dqv:inDimension <urn:ontolint:dimension-structure> ;
    olq:severity sh:Warning .

<urn:ontolint:metric-multiple-ontologies-in-one-file> a dqv:Metric ;
    rdfs:label "Multiple ontologies in one file" ;
    skos:definition "A single input declares more than one owl:Ontology; one file, one ontology." ;
    skos:prefLabel "Multiple ontologies in one file" ;
    dqv:inDimension <urn:ontolint:dimension-metadata> ;
    olq:severity sh:Violation .

<urn:ontolint:metric-namespace-hijacking> a dqv:Metric ;
    rdfs:label "Namespace hijacking" ;
    skos:definition "A resource is defined using an external vocabulary's namespace." ;
    skos:prefLabel "Namespace hijacking" ;
    dqv:inDimension <urn:ontolint:dimension-conformance> ;
    olq:severity sh:Violation .

<urn:ontolint:metric-non-unique-identifiers> a dqv:Metric ;
    rdfs:label "Non-unique identifiers" ;
    skos:definition "The same IRI is declared as more than one kind of class or property." ;
    skos:prefLabel "Non-unique identifiers" ;
    dqv:inDimension <urn:ontolint:dimension-uniqueness> ;
    olq:severity sh:Violation .

<urn:ontolint:metric-ontolint-conformance> a dqv:Metric ;
    rdfs:label "Ontolint conformance" ;
    skos:definition "Number of ontolint checks that failed for the dataset; 0 means every executed check passed." ;
    skos:prefLabel "Ontolint conformance" ;
    dqv:inDimension <urn:ontolint:dimension-conformance> .

<urn:ontolint:metric-properties-missing-description> a dqv:Metric ;
    rdfs:label "Property without description" ;
    skos:definition "A property has no description annotation." ;
    skos:prefLabel "Property without description" ;
    dqv:inDimension <urn:ontolint:dimension-documentation> ;
    olq:severity sh:Warning .

<urn:ontolint:metric-properties-missing-domain> a dqv:Metric ;
    rdfs:label "Property without domain" ;
    skos:definition "A property has no rdfs:domain." ;
    skos:prefLabel "Property without domain" ;
    dqv:inDimension <urn:ontolint:dimension-structure> ;
    olq:severity sh:Warning .

<urn:ontolint:metric-properties-missing-label> a dqv:Metric ;
    rdfs:label "Property without label" ;
    skos:definition "A property has no label annotation." ;
    skos:prefLabel "Property without label" ;
    dqv:inDimension <urn:ontolint:dimension-documentation> ;
    olq:severity sh:Violation .

<urn:ontolint:metric-properties-missing-range> a dqv:Metric ;
    rdfs:label "Property without range" ;
    skos:definition "A property has no rdfs:range." ;
    skos:prefLabel "Property without range" ;
    dqv:inDimension <urn:ontolint:dimension-structure> ;
    olq:severity sh:Warning .

<urn:ontolint:metric-properties-same-label> a dqv:Metric ;
    rdfs:label "Properties with the same label" ;
    skos:definition "Two or more properties share a label in the same language and with the same predicate." ;
    skos:prefLabel "Properties with the same label" ;
    dqv:inDimension <urn:ontolint:dimension-uniqueness> ;
    olq:severity sh:Violation .

<urn:ontolint:metric-subclass-cycles> a dqv:Metric ;
    rdfs:label "Subclass Cycles" ;
    skos:definition "A class is involved in an rdfs:subClassOf cycle." ;
    skos:prefLabel "Subclass Cycles" ;
    dqv:inDimension <urn:ontolint:dimension-structure> ;
    olq:severity sh:Violation .

