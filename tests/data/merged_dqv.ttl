<urn:ontolint:metric-ontolint-conformance> a dqv:Metric ;
    rdfs:label "Ontolint conformance" ;
    skos:definition "Number of ontolint checks that failed for the dataset; 0 means every executed check passed." ;
    skos:prefLabel "Ontolint conformance" ;
    dqv:inDimension <urn:ontolint:dimension-conformance> .

<urn:ontolint:metric-ontology-missing-description> a dqv:Metric ;
    rdfs:label "Ontology without description" ;
    skos:definition "A declared owl:Ontology has no rdfs:comment, dcterms:abstract or dcterms:description." ;
    skos:prefLabel "Ontology without description" ;
    dqv:inDimension <urn:ontolint:dimension-metadata> ;
    olq:severity sh:Violation .

