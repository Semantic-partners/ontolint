SELECT ?ps
WHERE {
    {
     	?ps a sh:PropertyShape  
    } UNION {
      	?ns sh:property ?ps .
      	FILTER(isBlank(?ps)) .
    }
    FILTER NOT EXISTS { 
    { ?ps rdfs:label|skos:prefLabel|skos:altLabel|skos:hiddenLabel [] }
    UNION
    {
      ?ps ?p [] .
      ?p a owl:AnnotationProperty .
    }
  }
}
