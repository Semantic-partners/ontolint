@prefix oqa: <https://voc.semanticpartners.com/ontology/quality-assurance#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix vann: <http://purl.org/vocab/vann/> .

oqa: a owl:Ontology ;
    rdfs:label "Ontology Quality Assurance Ontology"@en ;
    rdfs:comment """An ontology for the quality assurance of ontologies. The OQA is a collection of SHACL shapes targeting various quality dimensions:

* Ontology metadata: ensure that the ontology is declared and has a description; verify the resources specified in `owl:imports` ; 
* Human-readable annotations: ensure that every resource has labels and comments.
* Semantic clarity: ensure that each label is unique; ensure that properties have domain and range defined; ensure that the same resource is not defined as a class and a property; ensure that every resource in the ontology is properly defined;
* Structural integrity: ensure terms from external ontologies exist; ensure that every class is connected to the rest of the ontology; flag namespace hijacking; 
* Logical integrity: ensure that no cycles of `rdfs:subClassOf` exist."""@en ;
    owl:versionInfo "0.1" ;
    vann:preferredNamespacePrefix "oqa" ;
    vann:preferredNamespaceUri oqa: .
 
# SHACL Shapes
oqa:LabelAnnotation
    a sh:NodeShape ;
    rdfs:label "Label Annotation"@en ;
    rdfs:comment "Ensure that the target resources are annotated with one label."@en ;
    sh:targetClass owl:Class, rdfs:Class, owl:ObjectProperty, owl:DatatypeProperty, rdf:Property, owl:AnnotationProperty, sh:NodeShape, sh:PropertyShape ;
    sh:message "Label annotation failure: a valid label must be specified with a dedicated annotation property." ;
    sh:property oqa:LabelRule .

oqa:CommentAnnotation
    a sh:NodeShape ;
    rdfs:label "Comment Annotation"@en ;
    rdfs:comment "Ensure that the target resources are annotated with one comment."@en ;
    sh:targetClass owl:Class, rdfs:Class, owl:ObjectProperty, owl:DatatypeProperty, rdf:Property, owl:AnnotationProperty, sh:NodeShape, sh:PropertyShape ;
    sh:message "Comment annotation failure: a valid comment must be specified with a dedicated annotation property." ;
    sh:property oqa:CommentRule .

oqa:LabelRule
        a sh:PropertyShape ;
        rdfs:label "Regular Label"@en ;
        rdfs:comment "Label missing or not a string."@en ;
        sh:path [
            sh:alternativePath ( rdfs:label skos:prefLabel skos:altLabel skos:hiddenLabel )
        ] ;
        sh:minCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "FAILURE: label annotation missing or not a string." ;
        sh:name "Label predicates" ;
        sh:description "A list of different predicates that can be used to specify a label." .

oqa:CommentRule
        a sh:PropertyShape ;
        rdfs:label "Regular Comment"@en ;
        rdfs:comment "Comment missing or not a string."@en ;
        sh:path [
            sh:alternativePath ( rdfs:comment dcterms:description skos:definition )
        ] ;
        sh:minCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "FAILURE: comment annotation missing or not a string." ;
        sh:name "Comment predicates" ;
        sh:description "A list of different predicates that can be used to specify a comment." .

# The followint two instances of sh:SPARQLConstraint are kept as a reference for an alternative way to capture violations for a series of pre-determined annotation properties, or for custom-made annotation properties. This pattern is based on the assumption that a custom annotation property is also a subclass of the corresponding RDFS property, and that only a subsect of pre-defined predicates are allowed.

