# The one input behind the four reporter test suites: lint -> QAResult, lint -> Markdown,
# QAResult -> CTRF and QAResult -> DQV. They all describe the same run, so a change in what
# a check finds shows up in each of them and they can be compared against one another.
#
# It is deliberately mixed: some checks pass, some fail, and it carries the awkward cases —
# a blank node as a domain (rendered, so it must not vary run to run), a duplicate label, a
# deprecated class that checks must skip, and an isolated class.
#
# One term, one failure. Every term below is complete except for the single thing its
# comment names, so a check that changes moves one line of the stored expectations rather
# than several, and a term that appears twice in a report is a signal rather than noise.
# The only exception is owl:imports: an import that cannot be resolved is by construction
# also a namespace whose terms cannot be checked, so it fails both checks. That coupling is
# in the checks, not in this file.
@prefix :        <https://example.org/reporters#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .

# Unresolvable import: fails the import check, and the undefined-terms check with it.
: a owl:Ontology ;
    rdfs:label "Reporter fixture" ;
    dcterms:description "One ontology exercising every reporter." ;
    owl:imports <https://example.invalid/upstream> .

# --- Classes ---------------------------------------------------------------------------

# Passes everything.
:Animal a owl:Class ;
    rdfs:label "Animal" ;
    rdfs:comment "A living creature." .

# No label.
:Cat a owl:Class ;
    rdfs:subClassOf :Animal ;
    rdfs:comment "Has no label." .

# No description.
:Fish a owl:Class ;
    rdfs:subClassOf :Animal ;
    rdfs:label "Fish" .

# Share a label, in the same language tag: the two of them are one violation.
:Dog a owl:Class ;
    rdfs:subClassOf :Animal ;
    rdfs:label "Dog" ;
    rdfs:comment "Shares a label with :Hound." .

:Hound a owl:Class ;
    rdfs:subClassOf :Animal ;
    rdfs:label "Dog" ;
    rdfs:comment "Shares a label with :Dog." .

# Declared and never connected to anything: isolated. Nothing may reference it.
:Mineral a owl:Class ;
    rdfs:label "Mineral" ;
    rdfs:comment "Connected to nothing." .

# Deprecated, so the label and description checks must skip it.
:Beast a owl:DeprecatedClass ;
    owl:deprecated true .

# Each is the other's superclass: a subclass cycle.
:Predator a owl:Class ;
    rdfs:label "Predator" ;
    rdfs:comment "Cycles with :Carnivore." ;
    rdfs:subClassOf :Carnivore .

:Carnivore a owl:Class ;
    rdfs:label "Carnivore" ;
    rdfs:comment "Cycles with :Predator." ;
    rdfs:subClassOf :Predator .

# One IRI declared as two different kinds of thing.
:Ambiguous a owl:Class, owl:ObjectProperty ;
    rdfs:label "Ambiguous" ;
    rdfs:comment "Declared as both a class and a property." ;
    rdfs:subClassOf :Animal ;
    rdfs:domain :Animal ;
    rdfs:range :Animal .

# Instance data, which profiling counts and the checks exclude.
:rex a :Dog ;
    rdfs:label "Rex" .

# --- Properties --------------------------------------------------------------------------

# Passes everything. Its domain is an anonymous class expression, whose identifier is
# invented at parse time, so the report must not print it.
:hasHabitat a owl:ObjectProperty ;
    rdfs:label "has habitat" ;
    rdfs:comment "Where it lives." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Animal :Dog ) ] ;
    rdfs:range :Animal .

# No label.
:unlabelled a owl:ObjectProperty ;
    rdfs:comment "Has no label." ;
    rdfs:domain :Animal ;
    rdfs:range :Animal .

# No description.
:undescribed a owl:ObjectProperty ;
    rdfs:label "undescribed" ;
    rdfs:domain :Animal ;
    rdfs:range :Animal .

# No domain.
:withoutDomain a owl:ObjectProperty ;
    rdfs:label "without domain" ;
    rdfs:comment "Has no domain." ;
    rdfs:range :Animal .

# No range.
:withoutRange a owl:ObjectProperty ;
    rdfs:label "without range" ;
    rdfs:comment "Has no range." ;
    rdfs:domain :Animal .

# Share a skos:prefLabel: the two of them are one violation.
:hasName a owl:DatatypeProperty ;
    skos:prefLabel "has name" ;
    rdfs:comment "Shares a label with :alsoHasName." ;
    rdfs:domain :Animal ;
    rdfs:range rdfs:Literal .

:alsoHasName a owl:DatatypeProperty ;
    skos:prefLabel "has name" ;
    rdfs:comment "Shares a label with :hasName." ;
    rdfs:domain :Animal ;
    rdfs:range rdfs:Literal .

# Its parent property, :namingProperty, is referenced and never defined: an undefined term.
:refersToUndefined a owl:ObjectProperty ;
    rdfs:label "refers to undefined" ;
    rdfs:comment "Its parent property is never defined." ;
    rdfs:subPropertyOf :namingProperty ;
    rdfs:domain :Animal ;
    rdfs:range :Animal .

# Minted in the SKOS namespace, which this ontology does not own. skos:editorialNote is a
# real SKOS term, so the hijack is the only thing wrong with it; an invented one would
# also be an undefined term.
skos:editorialNote a owl:AnnotationProperty ;
    rdfs:label "editorial note" ;
    rdfs:comment "Hijacks a namespace belonging to someone else." ;
    rdfs:domain :Animal ;
    rdfs:range rdfs:Literal .

# --- Terms used without being declared ---------------------------------------------------

# Annotated but never typed, and used as a predicate below: untyped property.
:curatedBy rdfs:label "curated by" ;
    rdfs:comment "Has a label, but no rdf:Property or owl: type." .

:Dog :curatedBy "Taxonomy team" .

# Annotated but never typed, and used as a range below: untyped class.
:Habitat rdfs:label "Habitat" ;
    rdfs:comment "Has a label, but is never typed as a class." .

:livesIn a owl:ObjectProperty ;
    rdfs:label "lives in" ;
    rdfs:comment "Relates an animal to where it lives." ;
    rdfs:domain :Animal ;
    rdfs:range :Habitat .

# --- Shapes ------------------------------------------------------------------------------

# The shapes target :Cat rather than :Mineral, which has to stay unreferenced to keep
# failing the isolated-classes check.

# No label.
:UnlabelledShape a sh:NodeShape ;
    rdfs:comment "Has no label." ;
    sh:targetClass :Cat .

# No description.
:UndescribedShape a sh:NodeShape ;
    rdfs:label "Undescribed shape" ;
    sh:targetClass :Cat .

# Share a label: the two of them are one violation.
:AnimalShape a sh:NodeShape ;
    rdfs:label "Animal shape" ;
    rdfs:comment "Shares a label with :CreatureShape." ;
    sh:targetClass :Animal ;
    sh:property :animalNameShape .

:CreatureShape a sh:NodeShape ;
    rdfs:label "Animal shape" ;
    rdfs:comment "Shares a label with :AnimalShape." ;
    sh:targetClass :Dog .

# No label.
:unlabelledNameShape a sh:PropertyShape ;
    rdfs:comment "Has no label." ;
    sh:path :hasName .

# No description.
:undescribedNameShape a sh:PropertyShape ;
    rdfs:label "Undescribed name shape" ;
    sh:path :hasName .

# Share a label: the two of them are one violation.
:animalNameShape a sh:PropertyShape ;
    rdfs:label "Name shape" ;
    rdfs:comment "Shares a label with :creatureNameShape." ;
    sh:path :hasName .

:creatureNameShape a sh:PropertyShape ;
    rdfs:label "Name shape" ;
    rdfs:comment "Shares a label with :animalNameShape." ;
    sh:path :hasName .
