<https://example.org/qa#dependency-metric-ontology-missing-description-99fb3c38> a olq:Dependency ;
    rdfs:comment "A description is read off the declared owl:Ontology, so there is none to read without one." ;
    olq:dependent <https://example.org/qa#metric-ontology-missing-description> ;
    olq:prerequisite <https://example.org/qa#metric-ontology-not-declared> .

<https://example.org/qa#dependency-metric-unresolvable-imports-b81fcda7> a olq:Dependency ;
    rdfs:comment "owl:imports statements are read off the declared owl:Ontology." ;
    olq:dependent <https://example.org/qa#metric-unresolvable-imports> ;
    olq:prerequisite <https://example.org/qa#metric-ontology-not-declared> .

<https://example.org/qa#dependency-metric-untyped-classes-06450b30> a olq:Dependency ;
    rdfs:comment "Without a declared namespace, a class of the ontology's own cannot be told from an external vocabulary's." ;
    olq:dependent <https://example.org/qa#metric-untyped-classes> ;
    olq:prerequisite <https://example.org/qa#metric-ontology-not-declared> .

<https://example.org/qa#dependency-metric-untyped-properties-2bfd47c0> a olq:Dependency ;
    rdfs:comment "Without a declared namespace, a property of the ontology's own cannot be told from an external vocabulary's." ;
    olq:dependent <https://example.org/qa#metric-untyped-properties> ;
