# Untyped class
# Class without owl:Class or rdfs:Class declaration
SELECT ?c
WHERE {
  { ?s rdfs:domain ?c . }
  UNION
  { ?s rdfs:range ?c . }
  UNION
  { ?s sh:class ?c . }
  UNION
  { ?s rdfs:subClassOf ?c . }
  
  # exclude blank nodes
  FILTER(isIRI(?c))

  # Restrict to ontology namespace
  FILTER(STRSTARTS(STR(?c), ?ns ))

  # Filter out defined classes
  FILTER NOT EXISTS {
    ?c a ?type .
    VALUES ?type { owl:Class rdfs:Class }
  }
}
