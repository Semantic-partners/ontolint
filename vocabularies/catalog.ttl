    dcterms:source <https://schema.org/docs/developers.html> ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/3.0/> ;
    skos:changeNote "Removed a comment carried over from another project." ;
    dcat:distribution ontolint:vocabulary-schema-turtle .

ontolint:vocabulary-schema-turtle a dcat:Distribution ;
    dcat:downloadURL <schema.ttl> ;
