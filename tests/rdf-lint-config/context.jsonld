{
  "@context": {
    "@version": 1.1,
    "@protected": true,

    "olc":     "https://ontolint.org/config#",
    "check":   "https://ontolint.org/config/check#",
    "rdf":     "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs":    "http://www.w3.org/2000/01/rdf-schema#",
    "owl":     "http://www.w3.org/2002/07/owl#",
    "xsd":     "http://www.w3.org/2001/XMLSchema#",
    "skos":    "http://www.w3.org/2004/02/skos/core#",
    "sh":      "http://www.w3.org/ns/shacl#",
    "dcterms": "http://purl.org/dc/terms/",
    "foaf":    "http://xmlns.com/foaf/0.1/",
    "schema":  "https://schema.org/",
    "vs":      "http://www.w3.org/2003/06/sw-vocab-status/ns#",

    "enable":  { "@id": "olc:enable",  "@type": "@vocab", "@container": "@set",
                 "@context": { "@vocab": "https://ontolint.org/config/check#" } },
    "disable": { "@id": "olc:disable", "@type": "@vocab", "@container": "@set",
                 "@context": { "@vocab": "https://ontolint.org/config/check#" } },

    "imports":         "@nest",
    "exclude":         "@nest",
    "undefined-terms": "@nest",

    "ignore": { "@id": "olc:importIgnore", "@type": "@id", "@container": "@set", "@nest": "imports" },
    "local":  { "@id": "olc:importLocal",  "@type": "@id", "@container": "@index",
                "@index": "olc:providesNamespace", "@nest": "imports" },
    "olc:providesNamespace": { "@type": "@id" },

    "types":          { "@id": "olc:excludeType",  "@type": "@id", "@container": "@set", "@nest": "exclude" },
    "skip-object-of": { "@id": "olc:skipObjectOf", "@type": "@id", "@container": "@set", "@nest": "undefined-terms" }
  }
}
