SELECT ?ps ?lbl
WHERE {
    {
     	?ps a sh:PropertyShape  
    } UNION {
      	?ns sh:property ?ps .
      	FILTER(isBlank(?ps)) .
    }
    # Gather all labels
    {
      ?ps rdfs:label|skos:prefLabel|skos:altLabel|skos:hiddenLabel ?lbl
    }
    UNION
    {
      ?ps ?predicate ?lbl .
      ?predicate a owl:AnnotationProperty ;
      ?predicate rdfs:subPropertyOf* rdfs:label .
    }
}
