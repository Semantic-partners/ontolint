SELECT DISTINCT ?p
WHERE {
  VALUES ?type { owl:ObjectProperty owl:DatatypeProperty rdf:Property owl:AnnotationProperty }
  ?p a ?type .
  FILTER NOT EXISTS { 
    { ?p rdfs:label|skos:prefLabel|skos:altLabel|skos:hiddenLabel [] }
    UNION
    {
      ?p ?predicate [] .
      ?predicate a owl:AnnotationProperty .
    }
  }
  # Exclude deprecated properties
  FILTER NOT EXISTS {
    ?p owl:deprecated ?isDeprecated .
    FILTER (?isDeprecated = true || LCASE(STR(?isDeprecated)) = "true" || STR(?isDeprecated) = "1")
  }
}
