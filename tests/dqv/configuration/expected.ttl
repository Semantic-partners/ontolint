<https://example.org/qa#metric-classes-missing-label> a dqv:Metric ;
    rdfs:label "Class without label" ;
    skos:definition "A class has no label annotation." ;
    skos:prefLabel "Class without label" ;
    dqv:inDimension <https://example.org/qa#dimension-documentation> ;
    olq:severity sh:Violation .

<https://example.org/qa#metric-classes-same-label> a dqv:Metric ;
    rdfs:label "Classes with the same label" ;
    skos:definition "Two or more classes share a label in the same language." ;
    skos:prefLabel "Classes with the same label" ;
    dqv:inDimension <https://example.org/qa#dimension-uniqueness> ;
    olq:severity sh:Violation .

<https://example.org/qa#metric-isolated-classes> a dqv:Metric ;
    rdfs:label "Isolated classes" ;
    skos:definition "A class is declared but not connected to the rest of the ontology." ;
    skos:prefLabel "Isolated classes" ;
    dqv:inDimension <https://example.org/qa#dimension-structure> ;
    olq:severity sh:Warning .

<https://example.org/qa#metric-namespace-hijacking> a dqv:Metric ;
    rdfs:label "Namespace hijacking" ;
    skos:definition "A resource is defined using an external vocabulary's namespace." ;
    skos:prefLabel "Namespace hijacking" ;
    dqv:inDimension <https://example.org/qa#dimension-conformance> ;
    olq:severity sh:Violation .

