# PropertyShapes with the same label
SELECT ?label (GROUP_CONCAT(DISTINCT ?ps; separator=", ") AS ?psList)
WHERE {
    {
     	?ps a sh:PropertyShape
    } UNION {
      	?ns sh:property ?ps .
      	FILTER(isBlank(?ps)) .
    }

    # Gather all labels
    {
      VALUES ?labelProperty { rdfs:label skos:prefLabel skos:altLabel skos:hiddenLabel }
      ?ps ?labelProperty ?label .
    }
    UNION
    {
      ?PropertyShape ?predicate ?label .
      ?predicate a owl:AnnotationProperty ;
      rdfs:subPropertyOf* rdfs:label .
    }
}
GROUP BY ?label
HAVING (COUNT(DISTINCT ?ps) > 1)
