@prefix : <http://my.ont.example#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@base <http://my.ont.example#> .

:Dog a rdfs:Class ;
     rdfs:subClassOf :Animal .

:Cat a rdfs:Class ;
     rdfs:subClassOf :Animal .

:Animal a rdfs:Class ;
        rdfs:subClassOf :Organism ;
        rdfs:label "Animal" .

:Fish a rdfs:Class ;
      rdfs:subClassOf :Animal ;
      skos:prefLabel "Fish" .

:fin a rdfs:Class .

:hasFins a owl:ObjectProperty ;
  rdfs:domain :Fish ;
  rdfs:range :fin .

:myIsolatedClass a owl:Class ;
  rdfs:label "Isolated Class"@en ;
  rdfs:comment "This is a comment"@en .

:Trout a rdfs:Class ;
      rdfs:subClassOf :Animal ;
      skos:altLabel "Fish" .

:hasTail a owl:ObjectProperty ;
  rdfs:domain :Dog, :Cat .

# violation detected
# :myIsolatedClass a owl:DatatypeProperty .

# violation NOT detected
# :myIsolatedClass a rdfs:Class .

# violation NOT detected
:hasScales a owl:ObjectProperty .
:hasScales a rdf:Property .

# Including Cycles in a Class Hierarchy: violation detected
#:Organism a owl:Class ;
#     rdfs:subClassOf :Dog .

# untyped class test: violation detected
:hasFur a owl:ObjectProperty ;
  rdfs:domain :Dog, :Cat ;
  rdfs:range :Fur .

# namespace hijacking: violation detected
skos:Creature a rdfs:Class ;
  a owl:DeprecatedClass ;
  owl:equivalentClass :Organism .

# SHACL Shapes
:ShrimpShape a sh:NodeShape ;
  rdfs:label     "Shrimp" ;
  sh:description "Forget about Dogs and Cats: Shrimps are the best pets." ;
  sh:targetClass :Shrimp ;
  sh:property    :hasClawsShape .

:Shrimp a owl:Class ;
  rdfs:subClassOf :Animal .

:hasClawsShape a sh:PropertyShape ;
  sh:path  :hasClaws ; # target property
  sh:class :Claw ;     # target property object.
  sh:name  "Has Claws" .

:hasClaws a owl:ObjectProperty ;
  rdfs:domain :Shrimp ;
  rdfs:label  "Has Claws" ;
  rdfs:range  :Claw .

:Crab a sh:NodeShape, owl:Class ;
  rdfs:subClassOf :Animal ;
  sh:property     :hasClaws .

:AnimalShape a sh:NodeShape ;
  sh:name      "Animal-Shape" ;
  sh:description "Make sure the entity belongs to the animal kingdom." ;
  sh:targetClass :Shrimp, :Crab, :Fish, :Dog, :Cat .

# Example of data suffering from unclear semantics.
:Fuffy a :Dog ;
  :hasClaws :dogClaws .
  
:dogClaws a :Claw .
