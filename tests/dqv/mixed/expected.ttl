<https://example.org/qa#metric-classes-same-label> a dqv:Metric ;
    rdfs:label "Classes with the same label" ;
    skos:definition "Two or more classes share a label in the same language and with the same predicate." ;
    skos:prefLabel "Classes with the same label" ;
    dqv:inDimension <https://example.org/qa#dimension-uniqueness> ;
    olq:severity sh:Violation .

<https://example.org/qa#metric-multiple-ontologies-in-one-file> a dqv:Metric ;
    rdfs:label "Multiple ontologies in one file" ;
    skos:definition "A single input declares more than one owl:Ontology; one file, one ontology." ;
    skos:prefLabel "Multiple ontologies in one file" ;
    dqv:inDimension <https://example.org/qa#dimension-metadata> ;
    olq:severity sh:Violation .

<https://example.org/qa#metric-namespace-hijacking> a dqv:Metric ;
    rdfs:label "Namespace hijacking" ;
    skos:definition "A resource is defined using an external vocabulary's namespace." ;
    skos:prefLabel "Namespace hijacking" ;
    dqv:inDimension <https://example.org/qa#dimension-conformance> ;
    olq:severity sh:Violation .

