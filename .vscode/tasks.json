{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ontolint: lint",
      "type": "shell",
      "command": "source ${workspaceFolder}/.venv/bin/activate && ruff check scripts/ tests/",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": {
        "owner": "ruff",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^\\s+-->\\s+(.+):(\\d+):(\\d+)$",
          "file": 1,
          "line": 2,
          "column": 3
        }
      }
    }
  ]
}
