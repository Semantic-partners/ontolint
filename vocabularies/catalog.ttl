    dcterms:source <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcat:distribution ontolint:vocabulary-dcterms-turtle .

