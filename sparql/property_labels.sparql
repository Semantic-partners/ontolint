SELECT DISTINCT ?p ?lbl
WHERE {
  # Gather OWL and RDFS properties.
  {
    VALUES ?type { owl:ObjectProperty owl:DatatypeProperty rdf:Property owl:AnnotationProperty }
    ?p a ?type .
  }
  UNION
  {
    ?p rdfs:subClassOf* rdf:Property
  }
  UNION
  {
    ?p rdfs:subPropertyOf ?parent
  }
  ?p rdfs:label|skos:prefLabel|skos:altLabel|skos:hiddenLabel ?lbl

  # Gather all labels
  {
    ?p rdfs:label|skos:prefLabel|skos:altLabel|skos:hiddenLabel ?lbl
  }
  UNION
  {
    ?p ?predicate ?lbl .
    ?predicate a owl:AnnotationProperty ;
    ?predicate rdfs:subPropertyOf* rdfs:label .
  }
}
