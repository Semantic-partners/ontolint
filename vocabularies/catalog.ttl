    dcterms:source <https://schema.org/docs/developers.html> ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/3.0/> ;
    skos:changeNote "Derived from schema.ttl by rewriting http://schema.org/ to https://schema.org/, as schema.org publishes both forms." ;
    dcat:distribution ontolint:vocabulary-schema-https-turtle .

ontolint:vocabulary-schema-https-turtle a dcat:Distribution ;
    dcat:downloadURL <schema-https.ttl> ;
