# The one input behind the four reporter test suites: lint -> QAResult, lint -> Markdown,
# QAResult -> CTRF and QAResult -> DQV. They all describe the same run, so a change in what
# a check finds shows up in each of them and they can be compared against one another.
#
# It is deliberately mixed: some checks pass, some fail, and it carries the awkward cases —
# a blank node as a domain (rendered, so it must not vary run to run), a duplicate label, a
# deprecated class that checks must skip, and an isolated class.
@prefix :        <https://example.org/reporters#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .

: a owl:Ontology ;
    rdfs:label "Reporter fixture" ;
    dcterms:description "One ontology exercising every reporter." ;
    owl:imports <https://example.invalid/upstream> .

# Passes everything.
:Animal a owl:Class ;
    rdfs:label "Animal" ;
    rdfs:comment "A living creature." .

# Labelled, but no description: fails the class-description check only.
:Dog a owl:Class ;
    rdfs:subClassOf :Animal ;
    rdfs:label "Dog" .

# Neither label nor description.
:Cat a owl:Class ;
    rdfs:subClassOf :Animal .

# Shares a label with :Dog, in the same language tag.
:Hound a owl:Class ;
    rdfs:subClassOf :Animal ;
    rdfs:label "Dog" ;
    rdfs:comment "Clashes with :Dog by label." .

# Declared and never connected to anything: isolated.
:Mineral a owl:Class ;
    rdfs:label "Mineral" ;
    rdfs:comment "Connected to nothing." .

# Deprecated, so the label and description checks must skip it.
:Beast a owl:DeprecatedClass ;
    owl:deprecated true .

# Domain is an anonymous class expression: its identifier is invented at parse time, so the
# report must not print it.
:hasHabitat a owl:ObjectProperty ;
    rdfs:label "has habitat" ;
    rdfs:comment "Where it lives." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Animal :Dog ) ] ;
    rdfs:range :Animal .

# No domain, no range, no description.
:hasName a owl:DatatypeProperty ;
    skos:prefLabel "has name" .

# Instance data, which profiling counts and the checks exclude.
:rex a :Dog ;
    rdfs:label "Rex" .

# --- Properties ---------------------------------------------------------------------

# Neither label nor description.
:undocumented a owl:ObjectProperty ;
    rdfs:domain :Animal ;
    rdfs:range :Animal .

# Shares skos:prefLabel "has name" with :hasName.
:alsoHasName a owl:DatatypeProperty ;
    skos:prefLabel "has name" ;
    rdfs:comment "Clashes with :hasName by label." ;
    rdfs:domain :Animal ;
    rdfs:range rdfs:Literal .

# Referenced as a parent property but never defined anywhere.
:hasName rdfs:subPropertyOf :namingProperty .

# --- Terms used without being declared ------------------------------------------------

# Annotated but never typed, and used as a predicate below: untyped property.
:curatedBy rdfs:label "curated by" ;
    rdfs:comment "Has a label, but no rdf:Property or owl: type." .

:Dog :curatedBy "Taxonomy team" .

# Annotated but never typed, and used as a range below: untyped class.
:Habitat rdfs:label "Habitat" ;
    rdfs:comment "Has a label, but is never typed as a class." .

:livesIn a owl:ObjectProperty ;
    rdfs:label "lives in" ;
    rdfs:comment "Relates an animal to where it lives." ;
    rdfs:domain :Animal ;
    rdfs:range :Habitat .

# Minted in the SKOS namespace, which this ontology does not own.
skos:curatorNote a owl:AnnotationProperty ;
    rdfs:label "curator note" ;
    rdfs:comment "Hijacks a namespace belonging to someone else." .

# --- Structure ------------------------------------------------------------------------

# Each is the other's superclass.
:Predator a owl:Class ;
    rdfs:label "Predator" ;
    rdfs:comment "Cycles with :Carnivore." ;
    rdfs:subClassOf :Carnivore .

:Carnivore a owl:Class ;
    rdfs:label "Carnivore" ;
    rdfs:comment "Cycles with :Predator." ;
    rdfs:subClassOf :Predator .

# One IRI declared as two different kinds of thing.
:Ambiguous a owl:Class, owl:ObjectProperty ;
    rdfs:label "Ambiguous" ;
    rdfs:comment "Declared as both a class and a property." ;
    rdfs:subClassOf :Animal ;
    rdfs:domain :Animal ;
    rdfs:range :Animal .

# --- Shapes ---------------------------------------------------------------------------

# Neither label nor description. It targets :Cat rather than :Mineral, which has to stay
# unreferenced to keep failing the isolated-classes check.
:BareShape a sh:NodeShape ;
    sh:targetClass :Cat .

# Two NodeShapes sharing a label.
:AnimalShape a sh:NodeShape ;
    rdfs:label "Animal shape" ;
    rdfs:comment "Constrains an animal." ;
    sh:targetClass :Animal ;
    sh:property :animalNameShape .

:CreatureShape a sh:NodeShape ;
    rdfs:label "Animal shape" ;
    rdfs:comment "Clashes with :AnimalShape by label." ;
    sh:targetClass :Dog .

# Neither label nor description.
:bareNameShape a sh:PropertyShape ;
    sh:path :hasName .

# Two PropertyShapes sharing a label.
:animalNameShape a sh:PropertyShape ;
    rdfs:label "Name shape" ;
    rdfs:comment "Constrains a name." ;
    sh:path :hasName .

:creatureNameShape a sh:PropertyShape ;
    rdfs:label "Name shape" ;
    rdfs:comment "Clashes with :animalNameShape by label." ;
    sh:path :hasName .
