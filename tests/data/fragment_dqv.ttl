<urn:ontolint:metric-ontology-missing-description> a dqv:Metric ;
    rdfs:label "Ontology without description" ;
    skos:definition "A declared owl:Ontology has no rdfs:comment, dcterms:abstract or dcterms:description." ;
    skos:prefLabel "Ontology without description" ;
    dqv:inDimension <urn:ontolint:dimension-metadata> ;
    olq:severity sh:Violation .

<urn:ontolint:metric-ontology-not-declared> a dqv:Metric ;
    rdfs:label "Ontology without declaration" ;
    skos:definition "A processed file has no owl:Ontology declaration." ;
    skos:prefLabel "Ontology without declaration" ;
    dqv:inDimension <urn:ontolint:dimension-metadata> ;
    olq:severity sh:Violation .

<urn:ontolint:metric-undefined-terms> a dqv:Metric ;
    rdfs:label "Undefined terms" ;
    skos:definition "A term is used but defined neither locally nor in its vocabulary (bundled, local or fetched)." ;
    skos:prefLabel "Undefined terms" ;
    dqv:inDimension <urn:ontolint:dimension-conformance> ;
    olq:severity sh:Violation .

<urn:ontolint:metric-untyped-properties> a dqv:Metric ;
    rdfs:label "Untyped Properties" ;
    skos:definition "A term in the ontology namespace is used as a property but not declared as one." ;
    skos:prefLabel "Untyped Properties" ;
    dqv:inDimension <urn:ontolint:dimension-conformance> ;
    olq:severity sh:Violation .

<urn:ontolint:dimension-metadata> a dqv:Dimension ;
    rdfs:label "Metadata" ;
    skos:definition "The ontology declares itself and describes its purpose." ;
    skos:prefLabel "Metadata" .

<urn:ontolint:dimension-structure> a dqv:Dimension ;
    rdfs:label "Structure" ;
    skos:definition "Terms are connected into a well-formed hierarchy with domains and ranges." ;
    skos:prefLabel "Structure" .

<urn:ontolint:dimension-uniqueness> a dqv:Dimension ;
    rdfs:label "Uniqueness" ;
    skos:definition "Labels and identifiers unambiguously denote a single term." ;
    skos:prefLabel "Uniqueness" .

<https://example.org/input/fragment.ttl> rdfs:label "fragment.ttl" .

<urn:ontolint:dimension-conformance> a dqv:Dimension ;
    rdfs:label "Conformance" ;
    skos:definition "Terms are declared, resolvable and minted in the ontology's own namespace." ;
    skos:prefLabel "Conformance" .

<urn:ontolint:dimension-documentation> a dqv:Dimension ;
    rdfs:label "Documentation" ;
    skos:definition "Terms carry human-readable labels and descriptions." ;
    skos:prefLabel "Documentation" .

