<urn:ontolint:dependency-urn-ontolint-metric-ontology-missing-des-a63e2dc0> a olq:Dependency ;
    rdfs:comment "A description is read off the declared owl:Ontology, so there is none to read without one." ;
    olq:dependent <urn:ontolint:metric-ontology-missing-description> ;
    olq:prerequisite <urn:ontolint:metric-ontology-not-declared> .

<urn:ontolint:dependency-urn-ontolint-metric-untyped-classes-503e08e4> a olq:Dependency ;
    rdfs:comment "Without a declared namespace, a class of the ontology's own cannot be told from an external vocabulary's." ;
    olq:dependent <urn:ontolint:metric-untyped-classes> ;
    olq:prerequisite <urn:ontolint:metric-ontology-not-declared> .

<urn:ontolint:dependency-urn-ontolint-metric-untyped-properties-c188c85a> a olq:Dependency ;
    rdfs:comment "Without a declared namespace, a property of the ontology's own cannot be told from an external vocabulary's." ;
    olq:dependent <urn:ontolint:metric-untyped-properties> ;
    olq:prerequisite <urn:ontolint:metric-ontology-not-declared> .

<urn:ontolint:measurement-ontolint-conformance-e3b7f34d> a dqv:QualityMeasurement ;
    dqv:computedOn <https://example.org/input/fragment.ttl> ;
    dqv:isMeasurementOf <urn:ontolint:metric-ontolint-conformance> ;
    dqv:value 2 ;
    olq:conforms false .

<urn:ontolint:measurement-ontology-not-declared-469e57ac> a dqv:QualityMeasurement ;
