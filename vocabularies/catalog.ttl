# Catalogue of the vocabularies bundled with ontolint, as a DCAT catalog.
#
# Each dcat:Dataset is one vocabulary: its namespace (vann:preferredNamespaceUri), where it
# came from (dcterms:source), its licence and version, any local edits (skos:changeNote),
# and a dcat:Distribution whose dcat:downloadURL is the bundled file, relative to this one.
# ontolint reads this catalog to add every namespace to imports.local, so these
# namespaces and owl:imports of these ontologies resolve offline. Entries are matched with
# or without a trailing '#' or '/', and a project's own imports.local entry wins.

@prefix ontolint: <https://ontolint.org/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

ontolint:vocabularies a dcat:Catalog ;
    dcterms:title "Vocabularies bundled with ontolint" ;
    dcterms:description "Standard RDF vocabularies shipped with ontolint so their terms can be validated offline." ;
    dcat:dataset
        ontolint:vocabulary-rdf,
        ontolint:vocabulary-rdfs,
        ontolint:vocabulary-owl,
        ontolint:vocabulary-xsd,
        ontolint:vocabulary-shacl,
        ontolint:vocabulary-skos,
        ontolint:vocabulary-dcterms,
        ontolint:vocabulary-dc,
        ontolint:vocabulary-dcam,
        ontolint:vocabulary-dctype,
        ontolint:vocabulary-foaf,
        ontolint:vocabulary-vann,
        ontolint:vocabulary-vs,
        ontolint:vocabulary-prov,
        ontolint:vocabulary-org,
        ontolint:vocabulary-dcat3,
        ontolint:vocabulary-vcard,
        ontolint:vocabulary-schema,
        ontolint:vocabulary-schema-https .

ontolint:vocabulary-rdf a dcat:Dataset ;
    dcterms:title "RDF" ;
    vann:preferredNamespaceUri "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ;
    vann:preferredNamespacePrefix "rdf" ;
    dcterms:source <http://www.w3.org/1999/02/22-rdf-syntax-ns> ;
    dcterms:license <https://www.w3.org/copyright/software-license/> ;
    dcat:version "RDF 1.1 Concepts (2019-12-16) + RDF 1.2 terms" ;
    skos:changeNote "Extended with the RDF 1.2 terms the published namespace document does not yet include: rdf:dirLangString and rdf:reifies (RDF 1.2 Concepts), rdf:PropositionForm and rdf:propositionFormSubject/Predicate/Object (RDF 1.2 Interoperability), and the rdf:version-* IRIs. Header updated to say so." ;
    dcat:distribution ontolint:vocabulary-rdf-turtle .

ontolint:vocabulary-rdf-turtle a dcat:Distribution ;
    dcat:downloadURL <rdf.ttl> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> .

ontolint:vocabulary-rdfs a dcat:Dataset ;
    dcterms:title "RDF Schema" ;
    vann:preferredNamespaceUri "http://www.w3.org/2000/01/rdf-schema#" ;
    vann:preferredNamespacePrefix "rdfs" ;
    dcterms:source <http://www.w3.org/2000/01/rdf-schema> ;
    dcterms:license <https://www.w3.org/copyright/software-license/> ;
    dcat:distribution ontolint:vocabulary-rdfs-turtle .

ontolint:vocabulary-rdfs-turtle a dcat:Distribution ;
    dcat:downloadURL <rdfs.ttl> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> .

ontolint:vocabulary-owl a dcat:Dataset ;
    dcterms:title "OWL" ;
    vann:preferredNamespaceUri "http://www.w3.org/2002/07/owl#" ;
    vann:preferredNamespacePrefix "owl" ;
    dcterms:source <http://www.w3.org/2002/07/owl> ;
    dcterms:license <https://www.w3.org/copyright/software-license/> ;
    dcat:version "2009-11-15" ;
    skos:changeNote "Added owl:real and owl:rational, the OWL 2 datatypes from the OWL 2 Structural Specification section 4.1 that the namespace document omits." ;
    dcat:distribution ontolint:vocabulary-owl-turtle .

ontolint:vocabulary-owl-turtle a dcat:Distribution ;
    dcat:downloadURL <owl.ttl> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> .

ontolint:vocabulary-xsd a dcat:Dataset ;
    dcterms:title "XML Schema Definition (XSD) 1.1" ;
    vann:preferredNamespaceUri "http://www.w3.org/2001/XMLSchema#" ;
    vann:preferredNamespacePrefix "xsd" ;
    dcterms:source <https://www.w3.org/TR/xmlschema11-2/> ;
    dcterms:license <https://opensource.org/licenses/MIT>, <https://www.apache.org/licenses/LICENSE-2.0> ;
    dcat:version "XSD 1.1" ;
    skos:changeNote "Written for ontolint from XML Schema 1.1 Part 2: Datatypes, as W3C publishes no RDF for XSD. Lists every built-in datatype, the constraining and fundamental facets, and the date/time property names." ;
    dcat:distribution ontolint:vocabulary-xsd-turtle .

ontolint:vocabulary-xsd-turtle a dcat:Distribution ;
    dcat:downloadURL <xsd.ttl> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> .

ontolint:vocabulary-shacl a dcat:Dataset ;
    dcterms:title "SHACL" ;
    vann:preferredNamespaceUri "http://www.w3.org/ns/shacl#" ;
    vann:preferredNamespacePrefix "sh" ;
    dcterms:source <https://www.w3.org/ns/shacl.ttl> ;
    dcterms:license <https://www.w3.org/copyright/software-license/> ;
    dcat:version "2017-07-20 (SHACL 1.0)" ;
    skos:changeNote "No local edits. SHACL 1.2 terms are not included yet; map the namespace to a newer file via imports.local to use them." ;
    dcat:distribution ontolint:vocabulary-shacl-turtle .

ontolint:vocabulary-shacl-turtle a dcat:Distribution ;
    dcat:downloadURL <shacl.ttl> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> .

ontolint:vocabulary-skos a dcat:Dataset ;
    dcterms:title "SKOS" ;
    vann:preferredNamespaceUri "http://www.w3.org/2004/02/skos/core#" ;
    vann:preferredNamespacePrefix "skos" ;
    dcterms:source <http://www.w3.org/2004/02/skos/core> ;
    dcterms:license <https://www.w3.org/copyright/software-license/> ;
    dcat:version "SKOS Reference (2009)" ;
    dcat:distribution ontolint:vocabulary-skos-turtle .

ontolint:vocabulary-skos-turtle a dcat:Distribution ;
    dcat:downloadURL <skos.ttl> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> .

