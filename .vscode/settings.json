{
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.testing.cwd": "${workspaceFolder}",

  // Poetry keeps the environment in-project (.venv, see poetry.toml). Point at it directly
  // rather than relying on discovering poetry: VS Code launched from Finder doesn't get the
  // shell's PATH, so poetry often isn't found and no environment gets selected. If your
  // poetry isn't on PATH, set "python.poetryPath" in your user settings.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python-envs.defaultEnvManager": "ms-python.python:venv",
  "python-envs.defaultPackageManager": "ms-python.python:pip"
}
