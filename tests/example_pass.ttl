@prefix : <http://my.ont.example#> .
@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Animal a rdfs:Class ;
    rdfs:label "Animal" ;
    rdfs:comment "The class of all Animals" .

:Cat a rdfs:Class ;
    rdfs:label "Cat" ;
    rdfs:comment "The class of all Cats" ;
    rdfs:subClassOf :Animal .

:Claw a rdfs:Class ;
    rdfs:label "Claw" ;
    rdfs:comment "The class of all Claws" .

:Dog a rdfs:Class ;
    rdfs:label "Dog" ;
    rdfs:comment "The class of all Dogs" ;
    rdfs:subClassOf :Animal .

:Fish a rdfs:Class ;
    rdfs:comment "The class of all Fish" ;
    rdfs:subClassOf :Animal ;
    skos:prefLabel "Fish" .

:Fur a rdfs:Class ;
    rdfs:label "Fur" ;
    rdfs:comment "The class of all Fur" .

:Scales a rdfs:Class ;
    rdfs:label "Scales" ;
    rdfs:comment "The class of all Scales" .

:Tail a rdfs:Class ;
    rdfs:label "Tail" ;
    rdfs:comment "The class of all Tails" .

:Trout a rdfs:Class ;
    rdfs:comment "The class of all Trout" ;
    rdfs:subClassOf :Animal ;
    skos:prefLabel "Trout" .

:fin a rdfs:Class ;
    rdfs:label "Fin" ;
    rdfs:comment "The class of all Fins" .

: a owl:Ontology ;
    rdfs:label "Animal Ontology" ;
    rdfs:comment "A collection of loose concepts to verify the Quality Assurance workflow."@en ;
    owl:imports <http://example.org/> , <http://www.ignored.com> .

:AnimalShape a sh:NodeShape ;
    rdfs:comment "Make sure the entity belongs to the animal kingdom." ;
    rdfs:label "Animal-Shape" ;
    sh:targetClass :Cat,
        :Crab,
        :Dog,
        :Fish,
        :Shrimp .

:Fuffy a :Dog ;
    rdfs:label "Fuffy the Puddle" .

:Geck a ex:Reptiles ;
    rdfs:label "Geck the Gecko" .

:ShrimpShape a sh:NodeShape ;
    rdfs:label "Shrimp" ;
    rdfs:comment "Forget about Dogs and Cats: Shrimps are the best pets." ;
    sh:property :hasClawsShape ;
    sh:targetClass :Shrimp .

:hasFins a owl:ObjectProperty ;
    rdfs:label "Has Fins" ;
    rdfs:comment "Connects an animal to any fins it might have" ;
    rdfs:domain :Fish ;
    rdfs:range :fin .

:hasFur a owl:ObjectProperty ;
    rdfs:label "Has Fur" ;
    rdfs:comment "Connects an animal to any fur it might have" ;
    rdfs:domain :Cat,
        :Dog ;
    rdfs:range :Fur .

:hasScales a owl:ObjectProperty ;
    rdfs:label "Has Scales" ;
    rdfs:comment "Connects an animal to any scales it might have" ;
    rdfs:domain :Fish ;
    rdfs:range :Scales .

:hasTail a owl:ObjectProperty ;
    rdfs:label "Has Tail" ;
    rdfs:comment "Connects an animal to any fins it might have" ;
    rdfs:domain :Cat,
        :Dog ;
    rdfs:range :Tail .

:Crab a owl:Class,
        sh:NodeShape ;
    rdfs:label "Crab" ;
    rdfs:comment "The class of all Crabs" ;
    rdfs:subClassOf :Animal ;
    sh:description "Make sure the entity is an animal that has claws" ;
    sh:property :hasClaws .

:hasClawsShape a sh:PropertyShape ;
    rdfs:label "Has Claws Shape" ;
    sh:class :Claw ;
    rdfs:comment "connects via hasClaws to something of type Claw" ;
    sh:path :hasClaws .

:hasClaws a owl:ObjectProperty ;
    rdfs:label "Has Claws" ;
    rdfs:comment "connects an animal to any claws it might have" ;
    rdfs:domain :Shrimp ;
    rdfs:range :Claw .

:Shrimp a owl:Class ;
    rdfs:label "Shrimp" ;
    rdfs:comment "The class of all Shrimps" ;
    rdfs:subClassOf :Animal .

# Edge cases: isolated element
:PetName a owl:Class ;
    rdfs:label "Pet Name" ;
    rdfs:comment "The name of a pet. Not an isolated class!" .

:hasName a owl:ObjectProperty ;
    rdfs:label "has Name" ;
    rdfs:comment "If an animal has a name, than it's a pet." ;
    rdfs:domain :Animal ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf ( rdfs:Literal xsd:string :PetName ) ;
    ] .

:ObiWan a :PetName, owl:NamedIndividual .

:hasPart a owl:ObjectProperty ;
    rdfs:label "has Part" ;
    rdfs:comment "Basic Parthood relation" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

:Pond a owl:Class ;
    rdfs:label "Pond" ;
    rdfs:comment "A region holding freshwater for most time of the year." .

:FreshwaterEcosystem a owl:Class ;
    rdfs:label "Freshwater Ecosystem" ;
    rdfs:comment "A geographical area where interactions between living beings form an interconnected and inter-dependent web characterised by the presence of freshwater." ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty :hasPart ;
                        owl:someValuesFrom :Pond 
                    ] .