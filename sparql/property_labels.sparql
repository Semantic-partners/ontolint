PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?property ?label
WHERE {
  # Gather OWL and RDFS properties.
  {
    VALUES ?type { owl:ObjectProperty owl:DatatypeProperty rdf:Property owl:AnnotationProperty }
    ?property a ?type .
  }
  UNION
  {
    ?property rdfs:subClassOf+ rdf:Property
  }
  UNION
  {
    ?property rdfs:subPropertyOf ?parent
  }

  # Gather all labels
  {
    VALUES ?labelProperty { rdfs:label skos:prefLabel skos:altLabel skos:hiddenLabel }
    ?property ?labelProperty ?label
  }
  UNION
  {
    ?property ?predicate ?label .
    ?predicate a owl:AnnotationProperty ;
    rdfs:subPropertyOf* rdfs:label .
  }
}
